[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ocean_background.gd" id="1_ocean"]

[sub_resource type="Shader" id="Shader_ocean"]
code = "shader_type canvas_item;\nuniform vec4 top_color : source_color;\nuniform vec4 bottom_color : source_color;\nvoid fragment() {\n\tfloat depth = UV.y;\n\tvec3 water = mix(top_color.rgb, bottom_color.rgb, depth);\n\tfloat wave_a = sin(UV.x * 28.0 + TIME * 0.45 + sin(UV.y * 9.0)) * 0.5 + 0.5;\n\tfloat wave_b = sin(UV.y * 34.0 - TIME * 0.32 + UV.x * 11.0) * 0.5 + 0.5;\n\tfloat caustic = smoothstep(0.72, 1.0, wave_a * wave_b) * 0.045 * (1.0 - depth * 0.7);\n\tCOLOR = vec4(water + vec3(caustic * 0.5, caustic, caustic), 1.0);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ocean"]
shader = SubResource("Shader_ocean")
shader_parameter/top_color = Color(0.301961, 0.682353, 0.690196, 1)
shader_parameter/bottom_color = Color(0.047059, 0.32549, 0.419608, 1)

